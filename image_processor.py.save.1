import os
import io
from PIL import Image, ImageOps
import numpy as np

BACKGROUND_PATH = "/app/template/background.png"
PERSON_PATH = "/app/template/person.png"

FM_DIR = "/app/photos/FM"
A5_DIR = "/app/photos/A5"
THUMB_DIR = "/app/photos/Thumb"
PERS_DIR = "/app/photos/Perspective"
WEB300_DIR = "/app/photos/300"

for d in [FM_DIR, A5_DIR, THUMB_DIR, PERS_DIR, WEB300_DIR]:
    os.makedirs(d, exist_ok=True)


# ------------------------------------------------
# TIFF → JPG
# ------------------------------------------------
def convert_tiff_to_jpg(input_path):
    base, _ = os.path.splitext(input_path)
    output_path = base + "_300dpi.jpg"

    with Image.open(input_path) as img:
        img = img.convert("RGB")
        img.save(output_path, "JPEG", dpi=(300, 300), quality=95)

    return output_path


# ------------------------------------------------
# A5 image
# ------------------------------------------------
def create_a5(input_path, output_path):
    A5_W, A5_H = 1748, 2480
    img = Image.open(input_path).convert("RGB")
    a5 = ImageOps.fit(img, (A5_W, A5_H), Image.LANCZOS)
    a5.save(output_path, "JPEG", quality=90, dpi=(300, 300))
    return output_path


# ------------------------------------------------
# Thumbnail
# ------------------------------------------------
def create_thumbnail(input_path, output_path):
    img = Image.open(input_path).convert("RGB")
    img.thumbnail((250, 250), Image.LANCZOS)

    quality = 60
    for _ in range(10):
        buf = io.BytesIO()
        img.save(buf, "JPEG", quality=quality)
        if len(buf.getvalue()) / 1024 <= 10:
            with open(output_path, "wb") as f:
                f.write(buf.getvalue())
            return output_path
        quality -= 5

    return output_path


# ------------------------------------------------
# Remove white bg
# ------------------------------------------------
def remove_white(img):
    img = img.convert("RGBA")
    arr = np.array(img)
    r, g, b, a = np.rollaxis(arr, axis=-1)
    mask = (r > 240) & (g > 240) & (b > 240)
    arr[mask, 3] = 0
    return Image.fromarray(arr, "RGBA")


